# TRbotanik — ortam değişkenleri
# Bu dosyayı .env olarak kopyalayın ve değerleri kendinize göre düzenleyin.

# --- Veri modu -------------------------------------------------------------
# fixture : yalnızca yerel fixture verisi, hiçbir dış istek yapılmaz (geliştirme)
# static  : public/data altındaki gerçek artefaktlar, canlı çağrı yok
# live    : statik artefakt + talep üzerine canlı GBIF/iNaturalist zenginleştirme
VITE_DATA_MODE=fixture

# --- Altlık harita ---------------------------------------------------------
# offline           : uzak karo yok, düz arka plan + ülke sınırı (ağsız geliştirme)
# eox-s2cloudless   : EOX Sentinel-2 cloudless (CC BY-NC-SA 4.0, atıf zorunlu)
# esri-imagery      : Esri World Imagery (kullanım koşulları belirsiz, docs/DATA_SOURCES.md)
# maptiler-satellite: MapTiler uydu (VITE_MAPTILER_KEY gerekir)
VITE_BASEMAP=offline

# MapTiler kullanacaksanız API anahtarınız
VITE_MAPTILER_KEY=

# --- API (Faz 2'den itibaren) ---------------------------------------------
# SPA ile aynı origin'den servis edildiği için göreli yol yeterlidir.
VITE_API_BASE=/api
